{
    "compilerOptions": {
        // Output
        "outDir": "bin",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "stripInternal": true,
        // Environment
        "target": "ES2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "moduleDetection": "force",
        "types": ["node"],
        // Type Checking
        "strict": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitReturns": true,
        "skipLibCheck": true
    },
    "files": [
        "config/index.ts",
        "config/vars.ts",
        "configAuth.ts",
        "configSecurity.ts",
        "configSystem.ts",
        "garbageCollection.ts",
        "getGroups.ts",
        "getProject.ts",
        "getProjectMemberGroups.ts",
        "getProjectMemberUsers.ts",
        "getProjects.ts",
        "getRegistry.ts",
        "getRobotAccounts.ts",
        "getUsers.ts",
        "group.ts",
        "immutableTagRule.ts",
        "index.ts",
        "interrogationServices.ts",
        "label.ts",
        "preheatInstance.ts",
        "project.ts",
        "projectMemberGroup.ts",
        "projectMemberUser.ts",
        "projectWebhook.ts",
        "provider.ts",
        "purgeAuditLog.ts",
        "registry.ts",
        "replication.ts",
        "retentionPolicy.ts",
        "robotAccount.ts",
        "tasks.ts",
        "types/index.ts",
        "types/input.ts",
        "types/output.ts",
        "user.ts",
        "utilities.ts"
    ]
}
